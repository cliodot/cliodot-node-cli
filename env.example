PORT=
MONGODB_NAME=
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_URI=
MODE=

# Log verbosity: error | warn | info | debug
# production/live default to error (info/debug silenced). Keep errors visible.
LOG_LEVEL=error

JWT_SECRET=
JWT_EXPIRES_IN=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL_ADDRESS=
FROM_USER_NAME=

SALT_ROUNDS=
AWS_CONTENT_DISPOSITION=

APP_NAME=

TOKENIZER_SECRET_KEY=

GOOGLE_CLIENT_ID=

REDIS_URL=

EVENT_BROKER_FAST=bullmq
EVENT_BROKER_RELIABLE=bullmq
EVENT_BROKER_ORDERED=redis-streams
EVENT_BROKER_BROADCAST=bullmq
EVENT_BROKER_STREAM=
EVENT_BROKER_SCHEDULED=bullmq

KAFKA_BROKERS=
KAFKA_CLIENT_ID=cliodot-event
KAFKA_GROUP_ID=cliodot-event-bus
KAFKA_TOPIC_PREFIX=cliodot.events
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

RABBITMQ_URL=
RABBITMQ_EXCHANGE=cliodot.events
RABBITMQ_PREFETCH=20
RABBITMQ_QUEUE_PREFIX=cliodot.events

REDIS_STREAMS_URL=
REDIS_STREAMS_PREFIX=cliodot.events
REDIS_STREAMS_GROUP=cliodot-event-bus

BASE_DOMAIN=flowsync.com
CLIODOT_CLIENT_URL=https://api.yourdomain.com
APP_URL=
CLIODOT_BASE_URL=http://localhost:8901

STORAGE_TYPE=local or aws

MAX_FILE_SIZE=104857600    # 100MB
MAX_IMAGE_SIZE=10485760    # 10MB

AWS_S3_BUCKET=your-moments-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET_URL=https://your-bucket.s3.amazonaws.com

# Encryption Configuration for Project Secrets Encryption
# Required in production/live for connector installation auth and gateway JWT secrets
ENCRYPTION_KEY=

DEVICE_TOKEN_SECRET=
DEVICE_TOKEN_TTL_MS=31536000000
WEBHOOK_APP_RECEIVE_RETENTION_MS=259200000

# Allow outbound connector requests to private/local IPs (LAN devices, T&A, etc.)
# Required for http://192.168.x.x and similar private hosts. Keep false on public SaaS.
SSRF_ALLOW_PRIVATE_URLS=false

# Allow self-signed / invalid TLS certificates on outbound HTTPS connector/interop calls
OUTBOUND_TLS_INSECURE=false

# Gateway public endpoint rate limit (requests per minute per client)
GATEWAY_RATE_LIMIT_RPM=60

LOCAL_UPLOAD_DIR=moments
LOCAL_PUBLIC_URL=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=seeme-moments

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# Domain & SSL Configuration
CERT_DIR=./certs
ACME_EMAIL=your-email@example.com
ACME_STAGING=true
DOMAIN_VERIFICATION_SCHEDULE=*/5 * * * *

PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=


# ============================================
# ENTERPRISE LICENSING
# ============================================

# License Server URL (central validation server)
LICENSE_SERVER_URL=https://license.flowfly.dev

# AES-256 Encryption Key (256-bit hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_ENCRYPTION_KEY=

# RSA Public Key (for signature verification)
# Copy from .keys/license_public.pem
LICENSE_PUBLIC_KEY=

# Build Private Key (for manifest signing - KEEP SECURE!)
# Copy from .keys/license_private.pem
# ONLY needed during build process, not at runtime
BUILD_PRIVATE_KEY=

# Support email for license issues
SUPPORT_EMAIL=support@flowsync.com

# Optional: Telemetry and updates
TELEMETRY_ENABLED=false
AUTO_CHECK_UPDATES=true

CONNECTOR_CACHE_ENABLED=
CONNECTOR_CACHE_TTL=
CONNECTOR_CACHE_MAX_ENTRIES=

QUERY_CACHE_ENABLED=
QUERY_CACHE_DB_TTL=
QUERY_CACHE_API_TTL=
QUERY_CACHE_MAX_ENTRIES=
QUERY_CACHE_MAX_SIZE=

ENV_VARS_CACHE_ENABLED=
ENV_VARS_CACHE_TTL=
ENV_VARS_CACHE_MAX_ENTRIES=
# Use in-memory cache (default, single server)
CACHE_BACKEND=memory
# Use Redis cache (for autoscaling/multi-server)
# CACHE_BACKEND=redis

FAST_RUNTIME_MODE=legacy
DEV_RUNTIME_CACHE_ENABLED=false
PROD_ARTIFACT_RUNTIME=true
PROD_STORE_UI_SNAPSHOT=false
DOMAIN_CACHE_TTL=21600000
WORKFLOW_HOT_CACHE_MAX_ENTRIES=200
COMPILED_RUNTIME_TTL=604800000
COMPILED_RUNTIME_DEV_TTL=300000

# Connector runtime cache — full docs: src/app/flowsync/workflows/CONNECTOR_RUNTIME_CACHE.md
# Layer 1: immutable connector definitions by version (compile-time)
CONNECTOR_DEFINITION_CACHE_ENABLED=true
# Layer 2: resolved auth (headers/tokens/SMTP) hydrated once at compile, not raw schemas
CONNECTOR_AUTH_CACHE_ENABLED=true
# Layer 3: fully assembled connector + transportKey; execution reads these via bundle refs
CONNECTOR_RUNTIME_CACHE_ENABLED=true
# Serve last good runtime entry past TTL while rebuilding (reduces p99 spikes)
CONNECTOR_RUNTIME_STALE_WHILE_REVALIDATE=true
# In-process executor metadata reuse per tenant+connector+version+auth fingerprint
CONNECTOR_EXECUTOR_POOL_ENABLED=true
# Prod runtime Redis TTL (ms); defaults to COMPILED_RUNTIME_TTL if unset
CONNECTOR_RUNTIME_CACHE_TTL_PROD=604800000
# Dev runtime Redis TTL (ms); short so credential changes show quickly
CONNECTOR_RUNTIME_CACHE_TTL_DEV=300000
CONNECTOR_RUNTIME_CACHE_MAX_ENTRIES=10000
CONNECTOR_EXECUTOR_POOL_MAX_ENTRIES=500
# Cold-path installation metadata cache (auth/base_url from Mongo)
CONNECTOR_INSTALLATION_CACHE_ENABLED=true
CONNECTOR_INSTALLATION_CACHE_TTL=86400000

WORKFLOW_CACHE_BACKEND=redis
DOMAIN_CACHE_BACKEND=redis
GATEWAY_CACHE_BACKEND=redis

# LLM keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Deployment mode: local | production | enterprise
# local = developer (hub browse/mirror; publish denied)
# production = full hub when licensed/enabled
# enterprise = licensed hub/remote/exchange
DEPLOYMENT_MODE=production
CENTRAL_HUB_URL=https://hub.cliodot.com
DEPLOYMENT_ID=local-dev
DEPLOYMENT_REF=http://localhost:8901
CENTRAL_HUB_SYNC_API_KEY=hub_sync_key_dev
REMOTE_CONNECTORS_INTEROP_SECRET=
HUB_CONNECTORS_ENABLED=true
REMOTE_CONNECTORS_ENABLED=false
CONNECTOR_EXCHANGE_ENABLED=false

WORKFLOW_LOG_FLUSH_INTERVAL_MS=15000
WORKFLOW_LOG_BATCH_SIZE=300

# Memory
AI_COMPRESSION_THRESHOLD=20      # compress after N turns
AI_CONTEXT_RECENT_TURNS=6
AI_CONTEXT_RETRIEVED_TURNS=3
AI_CONTEXT_RETRIEVED_CONNECTORS=5
AI_SESSION_TTL_DAYS=7
AI_USE_TOOL_CALLING=true   # use LLM tool calling for scaffold/generate (set false to fall back to JSON parse)

CONNECTOR_OAUTH_CALLBACK_URL=http://localhost:3000/api/connectors/oauth/callback
OAUTH_APPS_API_HOST=http://localhost:8901

SSRF_ALLOW_PRIVATE_URLS=true
OUTBOUND_TLS_INSECURE=true
